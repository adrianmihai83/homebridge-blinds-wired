{
  "name": "homebridge-blinds-wired",
  "version": "2.0.2",
  "displayName": "Homebridge Blinds Wired",
  "description": "HomeKit support for non-smart motorized blinds through wired connection.",
  "author": "adrianmihai83",
  "homepage": "https://github.com/adrianmihai83/homebridge-blinds-wired#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianmihai83/homebridge-blinds-wired.git"
  },
  "bugs": {
    "url": "https://github.com/adrianmihai83/homebridge-blinds-wired/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-blinds-wired",
    "homebridge-plugin",
    "homekit",
    "blinds",
    "somfy",
    "shades",
    "window",
    "window covering"
  ],
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "clean": "rimraf ./dist",
    "lint": "tsc --noEmit",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test",
    "check": "npm test && npm pack --dry-run",
    "watch": "npm run build && npm link && nodemon"
  },
  "files": [
    "Changelog.md",
    "LICENSE.md",
    "README.md",
    "config.schema.json",
    "dist"
  ],
  "main": "dist/index.js",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.0.1",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "node-libgpiod": "^0.6.0"
  }
}
